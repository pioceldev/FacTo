{
    "name": "facto/facto",
    "description": "Application de gestion d'entreprise — facturation, stock, clients, devis, paiements et rapports",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "setasign/fpdf": "^1.8",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "FacTo\\": "backend/"
        },
        "files": [
            "backend/config.php",
            "backend/db.php",
            "backend/init.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FacTo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 backend/",
        "lint-fix": "phpcbf --standard=PSR12 backend/"
    },
    "config": {
        "allow-plugins": {
            "phpunit/phpunit": true
        }
    }
}